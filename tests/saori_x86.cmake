# x86 tests (SSP is 32-bit). Needs the x64 runtime and test assets from the
# msvc-x64 build, and optionally a local yaya.dll for the end-to-end ghost test.
set(UKA3D_RUNTIME_EXE "${CMAKE_SOURCE_DIR}/build/msvc-x64/$<CONFIG>/ukagaka3d.exe"
    CACHE FILEPATH "x64 ukagaka3d.exe used by the x86 tests")
set(UKA3D_TEST_ASSETS "${CMAKE_SOURCE_DIR}/build/msvc-x64/test-assets"
    CACHE PATH "Synthetic assets generated by the x64 build")
set(UKA3D_YAYA_DLL "${CMAKE_SOURCE_DIR}/../yaya/yaya.dll"
    CACHE FILEPATH "yaya.dll (YAYA 6, x86) for the sample-ghost test; not part of this repository")

add_executable(uka3d_x86_tests ${CMAKE_CURRENT_SOURCE_DIR}/x86_tests.cpp)
target_compile_definitions(uka3d_x86_tests PRIVATE ${UKA3D_DEFINES})
target_compile_options(uka3d_x86_tests PRIVATE ${UKA3D_WARNINGS})

add_test(NAME saori_x86
    COMMAND uka3d_x86_tests saori $<TARGET_FILE:ukagaka3d_saori> "${UKA3D_RUNTIME_EXE}" "${UKA3D_TEST_ASSETS}")
set_tests_properties(saori_x86 PROPERTIES LABELS "gui;ipc" RUN_SERIAL TRUE)

if(EXISTS "${UKA3D_YAYA_DLL}")
    add_test(NAME yaya_ghost_x86
        COMMAND uka3d_x86_tests yaya "${UKA3D_YAYA_DLL}" $<TARGET_FILE:ukagaka3d_saori> "${UKA3D_RUNTIME_EXE}"
                "${UKA3D_TEST_ASSETS}" "${CMAKE_SOURCE_DIR}/samples/yaya-ghost")
    set_tests_properties(yaya_ghost_x86 PROPERTIES LABELS "gui;ipc;yaya" RUN_SERIAL TRUE)
else()
    message(STATUS "ukagaka3d: yaya.dll not found (${UKA3D_YAYA_DLL}); yaya_ghost_x86 test disabled")
endif()
