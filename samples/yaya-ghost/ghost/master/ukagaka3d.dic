// ---------------------------------------------------------------------------
// ukagaka3d.dic - 3D シェル（ukagaka3d）を YAYA から操作する共通関数
//
// どの関数も 1（成功）か 0（失敗）を返す。失敗の理由は uk3d.error に入る。
// YAYA では、代入しない関数呼び出しは「出力候補」になってしまうので、
// トーク関数の中では必ず変数に代入して使うこと:
//
//     _ok = Play3DMotion("greet")
//     _ok = Set3DMorph("笑い", 1.0)
//
// 関数一覧
//   Launch3D()                         3D ランタイムを起動（ukagaka3d.json の model）
//   Launch3D("3d/model/xxx.pmx")       モデルを指定して起動
//   Load3DModel("3d/model/xxx.pmx")    モデルを読み替える
//   Play3DMotion("idle")               3d/motion/idle.vmd をループ再生
//   Play3DMotion("greet", 0, "idle")   1 回再生して、終わったら idle をループ再生
//   Play3DMotion("greet", 0, "idle", "none")   カメラトラック（greet.camera.json）を使わない
//   Stop3DMotion()                     モーション停止（基本姿勢、物理は継続）
//   Set3DMorph("笑い", 1.0)            モーフ（表情）の重みを 0〜1 で設定
//   Reset3DMorph()  / Reset3DMorph("笑い")
//   Status3D()                         uk3d.value に running / stopped、uk3d.detail に JSON
//   Configure3DFace(1, 1)              自動まばたき・視線追従の ON/OFF（省略・空は変更なし）
//   Configure3DFace("", "", 200)       視線が反応する頭からの距離（96dpi px、0 = 自動）
//   Shutdown3D()                       3D ランタイムを終了
//
// パスはゴーストのフォルダ（ghost/master）からの相対パス。フォルダの外は指定できない。
// ---------------------------------------------------------------------------

UK3D_DLL
{
    "ukagaka3d_saori.dll"
}

Load3DAccessory
{
    return Call3D("load_accessory", _argv[0], _argv[1])
}

Attach3DAccessory
{
    if _argc >= 3 {
        return Call3D("attach_accessory", _argv[0], _argv[1], _argv[2])
    }
    if _argc == 2 {
        return Call3D("attach_accessory", _argv[0], _argv[1])
    }
    return Call3D("attach_accessory", _argv[0])
}

Detach3DAccessory
{
    return Call3D("detach_accessory", _argv[0])
}

Unload3DAccessory
{
    return Call3D("unload_accessory", _argv[0])
