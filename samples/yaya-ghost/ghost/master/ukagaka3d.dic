}

Get3DAccessoryStatus
{
    return Call3D("get_accessory_status", _argv[0])
}

List3DAccessories
{
    return Call3D("list_accessories")
}

// SAORI/1.0 の要求を組み立てて送り、Result / Value0 / Value1 を取り出す。
Call3D
{
    _req = "EXECUTE SAORI/1.0" + CRLF + "Charset: UTF-8" + CRLF + "Sender: ukagaka3d-sample" + CRLF
    _req += "SecurityLevel: Local" + CRLF
    for _i = 0 ; _i < _argc ; _i++ {
        _arg = REPLACE(REPLACE(TOSTR(_argv[_i]), CHR(13), ""), CHR(10), "")
        _req += "Argument" + _i + ": " + _arg + CRLF
    }
    _req += CRLF

    uk3d.result = ""
    uk3d.value = ""
    uk3d.detail = ""
    if LOADLIB(UK3D_DLL) == 0 {
        uk3d.error = "SAORI（" + UK3D_DLL + "）を読み込めません"
        return 0
    }
    _res = REQUESTLIB(UK3D_DLL, _req)
    _lines = SPLIT(_res, CRLF)
    foreach _lines ; _line {
        _pos = STRSTR(_line, ": ", 0)
        if _pos > 0 {
            _key = SUBSTR(_line, 0, _pos)
            _value = SUBSTR(_line, _pos + 2, STRLEN(_line))
            if _key == "Result" {
                uk3d.result = _value
            }
            elseif _key == "Value0" {
                uk3d.value = _value
            }
            elseif _key == "Value1" {
                uk3d.detail = _value
            }
        }
    }
    if uk3d.result == "1" {
        uk3d.error = ""
        return 1
    }
    uk3d.error = uk3d.value
    if uk3d.error == "" {
        uk3d.error = "SAORI の応答が不正です"
    }
    return 0
}

Launch3D
{
    if _argc >= 1 {
        return Call3D("launch", _argv[0])
    }
    return Call3D("launch")
}

Load3DModel
{
    return Call3D("load_model", _argv[0])
}

Play3DMotion
{
    if _argc >= 4 {
        return Call3D("play_motion", _argv[0], _argv[1], _argv[2], _argv[3])
    }
    if _argc >= 3 {
        return Call3D("play_motion", _argv[0], _argv[1], _argv[2])
    }
    if _argc == 2 {
        return Call3D("play_motion", _argv[0], _argv[1])
    }
    return Call3D("play_motion", _argv[0])
}

